# ==============================================================================
# MedInsights Frontend - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your environment variables
# 
# IMPORTANT: Never commit .env to version control!
# ==============================================================================

#-------------------------------------------------------------------------------
# API Gateway Configuration
#-------------------------------------------------------------------------------
# Kong API Gateway URL - Single entry point for all backend services
# All API requests are routed through Kong Gateway which handles:
# - JWT authentication and validation
# - Service routing to microservices
# - CORS policy enforcement
# - Rate limiting
# - Request/response transformation
#
# Development: http://localhost:8000
# Staging:     https://api-staging.medinsights.com
# Production:  https://api.medinsights.com
#-------------------------------------------------------------------------------
VITE_KONG_GATEWAY_URL=http://localhost:8000

#-------------------------------------------------------------------------------
# Application Configuration
#-------------------------------------------------------------------------------
# Application name displayed in browser title and meta tags
VITE_APP_NAME=MedInsights

# Application version (should match package.json)
VITE_APP_VERSION=1.0.0

# Environment: development | staging | production
VITE_APP_ENV=development

#-------------------------------------------------------------------------------
# Feature Flags (Optional)
#-------------------------------------------------------------------------------
# Enable/disable features without code changes
# Set to 'true' or 'false'
#-------------------------------------------------------------------------------
# VITE_FEATURE_AI_ASSISTANT=true
# VITE_FEATURE_IMAGE_ANALYSIS=true
# VITE_FEATURE_DOCUMENT_OCR=true
# VITE_FEATURE_NOTIFICATIONS=false

#-------------------------------------------------------------------------------
# Development Options (Optional)
#-------------------------------------------------------------------------------
# Enable debug mode for additional console logging
# VITE_DEBUG=true

# Mock API responses (for development without backend)
# VITE_MOCK_API=false

#-------------------------------------------------------------------------------
# Direct Service URLs (Advanced - Development Only)
#-------------------------------------------------------------------------------
# WARNING: Only use these for local development when bypassing Kong Gateway
# In production, always use VITE_KONG_GATEWAY_URL
#-------------------------------------------------------------------------------
# VITE_AUTH_SERVICE_URL=http://localhost:8001
# VITE_PATIENT_SERVICE_URL=http://localhost:8080
# VITE_CHATBOT_SERVICE_URL=http://localhost:8002

#-------------------------------------------------------------------------------
# Analytics & Monitoring (Optional)
#-------------------------------------------------------------------------------
# Google Analytics ID
# VITE_GA_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

#-------------------------------------------------------------------------------
# Security Configuration (Optional)
#-------------------------------------------------------------------------------
# Session timeout in minutes (default: 30)
# VITE_SESSION_TIMEOUT=30

# Enable strict mode (additional security checks)
# VITE_STRICT_MODE=true

#===============================================================================
# QUICK START
#===============================================================================
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Edit .env and set VITE_KONG_GATEWAY_URL:
#    - Local: http://localhost:8000
#    - Production: https://api.medinsights.com
#
# 3. Verify Kong Gateway is running:
#    curl http://localhost:8000/auth/health
#
# 4. Start development server:
#    npm run dev
#
# 5. Access application:
#    http://localhost:5173
#===============================================================================
