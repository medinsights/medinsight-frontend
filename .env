# MedInsights Frontend - Development Environment
# ==============================================================================
# IMPORTANT: This file is for local development only
# Never commit this file to version control!
# ==============================================================================

# Kong API Gateway URL - All API requests go through Kong
VITE_KONG_GATEWAY_URL=http://localhost:8000

# Application Configuration
VITE_APP_NAME=MedInsights
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Development Options
VITE_DEBUG=true

# Feature Flags (all enabled for local development)
VITE_FEATURE_AI_ASSISTANT=true
VITE_FEATURE_IMAGE_ANALYSIS=true
VITE_FEATURE_DOCUMENT_OCR=true
VITE_FEATURE_NOTIFICATIONS=true

